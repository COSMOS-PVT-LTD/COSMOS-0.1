<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Deterministic>true</Deterministic>
    <StartupObject>CompactProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the unchanged source-field implementation, not an OCCT mesh. -->
    <Compile Include="../pico-components/Program.cs" Link="ComponentFields.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="PicoGK"><HintPath>$(PicoGKAssemblyRoot)/PicoGK.dll</HintPath></Reference>
  </ItemGroup>
</Project>
