# =============================================================================
# COSMOS 0.1 — Git ignore rules
# Proprietary repository — prevent accidental commit of secrets and local artifacts
# =============================================================================

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
service-account*.json
*.token
*.secret

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.pytype/
cython_debug/
*.cover

# Virtual environments
.venv/
.venv-remediation/
.venv-release-p12/
.venv-cad-inspection/
venv/
ENV/
env/
.envrc

# IDE and editor metadata
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs and temporary files
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig

# Local databases and generated credentials
*.sqlite
*.sqlite3
*.db
*.db-journal
local.db
generated_credentials/

# Local Knowledge Workspace runtime (never commit originals)
workspace_data/
knowledge_vault/
cosmos_app_data/
cosmos_app_data_verify/
credentials/

# Sensitive local datasets (explicit patterns — review before adding exceptions)
*_private_dataset/
*_confidential/
*_internal_only/

# Build and export artifacts (regenerable)
output/
exports/
reports/render_*/
qa/cosmos_architecture_render/

# Optional local tooling caches
.cache/
.runtime-picogk/
*.prof

# Local benchmark / qualification run artifacts
documentation/development/concurrency-tmp/
documentation/development/scale-tmp/

# Local .NET build caches and preview application state
bin/
obj/
/cosmos_r07_preview_data/

# Regenerable native geometry and review archives; keep reports/manifests in Git.
docs/implementation/**/*.stl
docs/implementation/**/*.step
docs/implementation/**/*.brep
docs/implementation/**/*.vdb
docs/implementation/**/*.zip
# Small deterministic reimport fixture required by the validation regression.
!docs/implementation/evidence/P09_2026-10-10/handoff-exact-sphere.step

# Local copies of third-party reference media are not application source assets.
docs/implementation/evidence/ENGINE_REFERENCE_REVIEW_2026-10-28/*.png
docs/implementation/evidence/ENGINE_REFERENCE_REVIEW_2026-10-28/*.jpg

# Local machine/library inventories and identity-bearing session exports
docs/implementation/evidence/ENGINE_REFERENCE_REVIEW_2026-10-28/MATERIALS_INVENTORY.json
docs/implementation/evidence/ENGINE_REFERENCE_REVIEW_2026-10-28/PRIORITY_PAGE_MAP.json
docs/implementation/evidence/ENGINE_REFERENCE_REVIEW_2026-10-28/STATUS.json
docs/implementation/evidence/DESKTOP_STANDALONE_2026-10-28/workspaces.json
docs/implementation/reviews/2026-10-11_COMPLETE_REVIEW/session.json
docs/implementation/evidence/P12_2026-10-11/github-repository.json
docs/implementation/evidence/P12_2026-10-11/inventory*/installed-file-integrity.json
docs/implementation/evidence/R05_3_2026-10-17/runtime-inventory.json
docs/implementation/evidence/ENGINE_BASELINE_SWITCH_2026-10-28/preview.json
