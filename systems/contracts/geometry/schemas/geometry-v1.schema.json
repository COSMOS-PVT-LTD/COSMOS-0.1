        "geometry_revision_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[0-9a-f]{64}$"
        },
        "feature_graph_sha256": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[0-9a-f]{64}$"
        },
        "representation": {
          "type": "string",
          "enum": [
            "analytic_brep",
            "implicit_field",
            "tessellated_surface",
            "faceted_brep"
          ]
        },
        "approximation_profile": {
          "type": "string",
          "maxLength": 2048
        },
        "backend_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "backend_version": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "units": {
          "const": "m"
        },
        "frame_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "export_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voxel_resolution_m": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_artifact_sha256": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_format": {
          "type": "string",
          "enum": [
            "step",
            "stl",
            "glb",
            "vdb"
          ]
        },
        "storage_uri": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "topology_report_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "generated_at": {
          "type": "string",
          "maxLength": 2048,
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        }
      }
