    "NamedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "contract_type",
        "entity_refs",
        "feature_ref",
        "geometry_revision_id",
        "mapping_status",
        "remap_confidence",
        "schema_version",
        "semantic_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "contract_type": {
          "const": "NamedSelection"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "geometry_revision_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "feature_ref": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "entity_refs": {
          "type": "array",
