        "contract_type",
        "export_tolerance_m",
        "feature_graph_sha256",
        "frame_id",
        "generated_at",
        "geometry_revision_id",
        "job_id",
        "output_format",
        "representation",
        "schema_version",
        "sha256",
        "size_bytes",
        "snapshot_id",
        "source_artifact_sha256",
        "source_tolerance_m",
        "storage_uri",
        "topology_report_id",
        "units",
        "voxel_resolution_m"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "contract_type": {
          "const": "GeometryArtifact"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "job_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
